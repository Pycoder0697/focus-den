# ---- Notion ----
# Create an internal integration at https://www.notion.so/my-integrations
# then "Connect" your database to it (database ••• menu → Connections).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The database ID from your Notion DB URL:
# https://www.notion.so/<workspace>/<THIS_32_CHAR_ID>?v=...
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Focus Den's Firebase Realtime DB ----
# Same values as CLOUD.url / CLOUD.key in index.html (or the in-app cloud setup).
FIREBASE_URL=https://your-project-default-rtdb.firebaseio.com
FOCUSDEN_KEY=your-long-private-key

# ---- Behaviour ----
# How often to reconcile (ms). 30s is gentle on both APIs.
SYNC_INTERVAL_MS=30000
# Who wins when BOTH sides changed the same task between syncs: notion | focusden
CONFLICT_WINNER=notion
# If a task is deleted on one side, mirror the delete on the other? true | false
MIRROR_DELETES=true
# Status/health server port
PORT=8787
